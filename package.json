{
  "name": "a-menu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "import:menu": "node scripts/import-menu-library.mjs",
    "clean:synology": "node scripts/clean-synology.mjs",
    "build": "node scripts/clean-synology.mjs && next build",
    "mobile:dev": "vite --config mobile/vite.config.mjs",
    "mobile:build": "vite build --config mobile/vite.config.mjs",
    "mobile:typecheck": "tsc --project mobile/tsconfig.json",
    "ios:prepare": "node scripts/prepare-ios.mjs",
    "ios:ipa": "node scripts/prepare-ios.mjs && node scripts/build-ios-ipa.mjs",
    "test:mobile": "node --test tests/mobile-config.test.mjs tests/book-layout.test.mjs tests/recipe-store.test.mjs tests/dish-photos.test.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "lucide-react": "^1.65.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^7.3.7"
  }
}
